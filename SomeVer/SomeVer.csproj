<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net472</TargetFrameworks>
    <LangVersion>default</LangVersion>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>

    <Description>MSBuild SDK to bring minimalist versioning using Git tags to your build system.</Description>
    <PackageProjectUrl>https://github.com/robmen/somever</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>SomeVer.png</PackageIcon>
    <PackageType>MSBuildSdk</PackageType>
    <SomeVerTaskTargetFramework Condition="'$(MSBuildRuntimeType)' == 'Core'">net10.0</SomeVerTaskTargetFramework>
    <SomeVerTaskTargetFramework Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</SomeVerTaskTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SomeVer.png" PackagePath="\" />
    <Content Include="Sdk\*.*" PackagePath="Sdk" />
    <Content Include="build\*.*" PackagePath="build" />
    <Content Include="buildMultiTargeting\*.*" PackagePath="buildMultiTargeting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SomeVerTasks\SomeVerTasks.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=$(SomeVerTaskTargetFramework)" />
  </ItemGroup>

  <Target Name="IncludeTaskBinaries" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\SomeVerTasks\SomeVerTasks.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework" />
    <ItemGroup>
      <Content Include="..\SomeVerTasks\bin\$(Configuration)\net472\NuGet.Versioning.dll" PackagePath="tools\net472\NuGet.Versioning.dll" />
      <Content Include="..\SomeVerTasks\bin\$(Configuration)\net472\MinVer.Lib.dll" PackagePath="tools\net472\MinVer.Lib.dll" />
      <Content Include="..\SomeVerTasks\bin\$(Configuration)\net472\SomeVerTasks.dll" PackagePath="tools\net472\SomeVerTasks.dll" />
      <Content Include="..\SomeVerTasks\bin\$(Configuration)\net10.0\MinVer.Lib.dll" PackagePath="tools\net10.0\MinVer.Lib.dll" />
      <Content Include="..\SomeVerTasks\bin\$(Configuration)\net10.0\SomeVerTasks.dll" PackagePath="tools\net10.0\SomeVerTasks.dll" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <SomeVerTagPrefix>v</SomeVerTagPrefix>
    <SomeVerDefaultPreReleaseIdentifiers>dev</SomeVerDefaultPreReleaseIdentifiers>

    <SomeVerDetailed>low</SomeVerDetailed>
    <SomeVerTasksPath Condition=" '$(MSBuildRuntimeType)' == 'Core' ">$(MSBuildThisFileDirectory)..\SomeVerTasks\bin\$(Configuration)\net10.0\SomeVerTasks.dll</SomeVerTasksPath>
    <SomeVerTasksPath Condition=" '$(SomeVerTasksPath)' == '' ">$(MSBuildThisFileDirectory)..\SomeVerTasks\bin\$(Configuration)\net472\SomeVerTasks.dll</SomeVerTasksPath>
  </PropertyGroup>
  <Import Project="build\SomeVer.targets" Condition=" '$(NCrunch)'=='' " />

</Project>
