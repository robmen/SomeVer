<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SomeVerPropsImported>true</SomeVerPropsImported>
    <MSBuildAllProjects Condition="'$(MSBuildToolsVersion)' != 'Current'">$(MSBuildAllProjects);$(MsBuildThisFileFullPath)</MSBuildAllProjects>
    <SomeVerDetailed Condition="'$(SomeVerDetailed)' == ''">low</SomeVerDetailed>
    <SomeVerTagPrefix Condition="'$(SomeVerTagPrefix)' == ''">v</SomeVerTagPrefix>
    <SomeVerDefaultPreReleaseIdentifiers Condition="'$(SomeVerDefaultPreReleaseIdentifiers)' == ''">dev</SomeVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
</Project>
